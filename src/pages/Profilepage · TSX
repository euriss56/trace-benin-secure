import { useEffect, useState } from 'react';
import { User, Save, Loader2, Mail } from 'lucide-react';
import { toast } from 'sonner';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { supabase } from '@/integrations/supabase/client';
import { useAuth } from '@/hooks/useAuth';
import { useProfile } from '@/hooks/useProfile';
import { CertifiedBadge, isDealerCertified } from '@/components/dashboard/CertifiedBadge';

export function ProfilePage() {
  const { user } = useAuth();
  const { profile, loading } = useProfile();
  const [prenom, setPrenom] = useState('');
  const [nom, setNom] = useState('');
  const [avatar, setAvatar] = useState('');
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    if (profile) {
      setPrenom(profile.prenom ?? '');
      setNom(profile.nom ?? '');
      setAvatar(profile.avatar_url ?? '');
    }
  }, [profile]);

  const save = async () => {
    if (!user) return;
    setSaving(true);
    const { error } = await supabase
      .from('profiles')
      .update({
        prenom: prenom.trim().slice(0, 80),
        nom: nom.trim().slice(0, 80),
        avatar_url: avatar.trim().slice(0, 500) || null,
      })
      .eq('id', user.id);
    setSaving(false);
    if (error) {
      toast.error("Échec de l'enregistrement.");
      return;
    }
    toast.success('Profil mis à jour.');
  };

  if (loading) {
    return <div className="h-64 animate-pulse rounded-2xl bg-muted/40" />;
  }

  return (
    <div>
      <header className="mb-6 flex items-center gap-3">
        <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <User className="h-5 w-5" />
        </div>
        <div>
          <h1 className="text-2xl font-bold">Mon profil</h1>
          <p className="text-sm text-muted-foreground">Identité, contact et statut de confiance.</p>
        </div>
      </header>

      <div className="grid gap-6 lg:grid-cols-[260px_1fr]">
        {/* Carte identité */}
        <div className="space-y-4 rounded-2xl border border-border bg-card p-6 shadow-sm">
          <div className="flex flex-col items-center text-center">
            <div className="mb-3 h-24 w-24 overflow-hidden rounded-full border-2 border-border bg-muted">
              {avatar ? (
                <img src={avatar} alt="" className="h-full w-full object-cover" />
              ) : (
                <div className="flex h-full w-full items-center justify-center text-3xl font-bold text-muted-foreground">
                  {(prenom[0] || user?.email?.[0] || '?').toUpperCase()}
                </div>
              )}
            </div>
            <div className="text-lg font-semibold">
              {[prenom, nom].filter(Boolean).join(' ') || '—'}
            </div>
            <div className="mt-1 flex items-center gap-1.5 text-xs text-muted-foreground">
              <span className="capitalize">{profile?.role ?? 'particulier'}</span>
              {isDealerCertified(profile?.role, profile?.niveau_confiance) && <CertifiedBadge />}
            </div>
            <div className="mt-3 flex items-center gap-1 text-xs text-muted-foreground">
              <Mail className="h-3 w-3" />
              {user?.email}
            </div>
          </div>
          <div className="rounded-xl bg-muted/40 p-3 text-center">
            <div className="text-xs uppercase text-muted-foreground">Niveau de confiance</div>
            <div className="text-2xl font-bold text-primary">
              {profile?.niveau_confiance ?? 0}
            </div>
          </div>
        </div>

        {/* Formulaire */}
        <div className="rounded-2xl border border-border bg-card p-6 shadow-sm">
          <h2 className="mb-4 text-lg font-semibold">Informations personnelles</h2>
          <div className="grid gap-4 sm:grid-cols-2">
            <div>
              <Label htmlFor="prenom">Prénom</Label>
              <Input
                id="prenom"
                value={prenom}
                maxLength={80}
                onChange={(e) => setPrenom(e.target.value)}
              />
            </div>
            <div>
              <Label htmlFor="nom">Nom</Label>
              <Input
                id="nom"
                value={nom}
                maxLength={80}
                onChange={(e) => setNom(e.target.value)}
              />
            </div>
            <div className="sm:col-span-2">
              <Label htmlFor="avatar">URL de l'avatar (optionnel)</Label>
              <Input
                id="avatar"
                type="url"
                placeholder="https://…"
                value={avatar}
                maxLength={500}
                onChange={(e) => setAvatar(e.target.value)}
              />
            </div>
          </div>
          <div className="mt-6 flex justify-end">
            <Button onClick={save} disabled={saving}>
              {saving ? <Loader2 className="h-4 w-4 animate-spin" /> : <Save className="h-4 w-4" />}
              Enregistrer
            </Button>
          </div>
        </div>
      </div>
    </div>
  );
}
