import { BadgeCheck } from 'lucide-react';
import { cn } from '@/lib/utils';

/**
 * Badge visuel affiché pour les dealers dont le niveau_confiance atteint le seuil.
 * Purement présentationnel — l'évaluation de confiance se fait en amont.
 */
const CERTIFIED_THRESHOLD = 70;

export function isDealerCertified(role?: string | null, niveau?: number | null) {
  return role === 'dealer' && (niveau ?? 0) >= CERTIFIED_THRESHOLD;
}

export function CertifiedBadge({
  className,
  size = 'sm',
}: {
  className?: string;
  size?: 'sm' | 'md';
}) {
  return (
    <span
      className={cn(
        'inline-flex items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 font-medium text-emerald-600 dark:text-emerald-400',
        size === 'sm' ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-1 text-xs',
        className
      )}
      title="Dealer certifié TraceIMEI-BJ"
    >
      <BadgeCheck className={size === 'sm' ? 'h-3 w-3' : 'h-3.5 w-3.5'} />
      Certifié
    </span>
  );
}
